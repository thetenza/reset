# --- Сайт ---
NODE_ENV=production
PORT=3000
BASE_URL=https://reset.example

# --- Digiseller (пока не задан SELLER_ID — сайт работает в демо-режиме) ---
DIGISELLER_SELLER_ID=
DIGISELLER_API_KEY=            # только на сервере, в браузер не попадает
DIGISELLER_CURRENCY=RUB
DIGISELLER_LANG=ru-RU

# --- Вход по коду: значения из действующих требований авторизации RESET (обязательно в production) ---
AUTH_CODE_TTL_SEC=
AUTH_RESEND_COOLDOWN_SEC=
AUTH_MAX_CODE_ATTEMPTS=

# --- Почта (коды входа и ответы поддержки) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Поддержка: куда доставлять обращения и что показывать публично ---
SUPPORT_EMAIL=
SUPPORT_TELEGRAM_BOT_TOKEN=
SUPPORT_TELEGRAM_CHAT_ID=
SUPPORT_PUBLIC_TELEGRAM=
SUPPORT_HOURS=

# --- Админы (через запятую, входят по тому же коду на email) ---
ADMIN_EMAILS=

# --- Подвал ---
LEGAL_OWNER_NAME=
LEGAL_OWNER_DETAILS=

# Название магазина
BRAND_NAME=RESET
